__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Benchmark data is downloaded/derived, never committed.
data/raw/*
data/processed/*
data/manifests/*
!data/**/.gitkeep

# Runtime artifacts are separated by purpose; keep only directory markers.
models/checkpoints/*
!models/checkpoints/.gitkeep
cache/*
!cache/.gitkeep
logs/*
!logs/*/
logs/*/*
!logs/*/.gitkeep
saves/*
!saves/*/
saves/*/*
!saves/*/.gitkeep
metrics/*
!metrics/.gitkeep

Writing/
